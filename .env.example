# Copy to .env for local development. Never put secrets here: OAuth tokens go to the OS credential store.
# All values are optional; the defaults below are what the code uses when unset.

# --- Desktop runtime (apps/desktop/src-tauri) — read by the Rust app, which starts the services ---
# Ports the runtime gives the API and worker.
CLIPFORGE_API_PORT=4317
# Minimum free memory before the worker may start.
CLIPFORGE_WORKER_MIN_FREE_MB=1024
# Log rotation / retention (files in <data dir>/logs).
CLIPFORGE_LOG_MAX_FILE_MB=5
CLIPFORGE_LOG_MAX_DIR_MB=100
CLIPFORGE_LOG_RETENTION_DAYS=14

# --- API (services/api) ---
NODE_ENV=development
# Loopback only (127.0.0.1, ::1, localhost). Anything else is rejected at startup.
CLIPFORGE_API_HOST=127.0.0.1
# Session secret: generated per launch by the desktop app. Set it yourself ONLY for a standalone
# `pnpm dev:api` (openssl rand -hex 32), never in this file. See docs/DEVELOPMENT.md.
# CLIPFORGE_API_SECRET=
# Jobs: concurrent running jobs (1-4) and queue cap (backpressure beyond it).
CLIPFORGE_JOB_CONCURRENCY=1
CLIPFORGE_JOB_MAX_QUEUED=500
CLIPFORGE_LOG_LEVEL=info
# Override the SQLite file. Default: <user data dir>/data/app.db
# CLIPFORGE_DATABASE_PATH=
# Override the whole user data dir (macOS: ~/Library/Application Support/com.clipforge.local)
# CLIPFORGE_DATA_DIR=

# --- Worker (services/worker) ---
CLIPFORGE_WORKER_HOST=127.0.0.1
CLIPFORGE_WORKER_PORT=4318
CLIPFORGE_WORKER_MAX_JOBS=1
